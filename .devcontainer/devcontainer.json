{
  "name": "Elevate",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20",
  "containerUser": "node",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "runArgs": ["--network=devnet"],

  "forwardPorts": [3000, 4200],

  "containerEnv": {
    "PGHOST": "postgres",
    "PGPORT": "5432",
    "PGDATABASE": "elevate",
    "PGUSER": "postgres",
    "PGPASSWORD": "postgres"
  },

  "postCreateCommand": "npm install --prefix webapp/server && npm install --prefix appcore"
}