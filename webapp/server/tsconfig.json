{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "target": "es2020",
    "module": "node16",
    "lib": ["es2020", "dom"],
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "paths": {
      "*": ["./*"],
      "@elevate/shared/constants/*": ["../../appcore/modules/shared/constants/*"],
      "@elevate/shared/enums/*": ["../../appcore/modules/shared/enums/*"],
      "@elevate/shared/data/*": ["../../appcore/modules/shared/data/*"],
      "@elevate/shared/sync/*": ["../../appcore/modules/shared/sync/*"],
      "@elevate/shared/models/*": ["../../appcore/modules/shared/models/*"],
      "@elevate/shared/resolvers/*": ["../../appcore/modules/shared/resolvers/*"],
      "@elevate/shared/exceptions/*": ["../../appcore/modules/shared/exceptions/*"],
      "@elevate/shared/tools/*": ["../../appcore/modules/shared/tools/*"]
    }
  },
  "include": ["./src/**/*.ts", "!./src/**/*.spec.ts", "./../../appcore/modules/**/*.ts"],
  "exclude": [
    "./../../appcore/modules/shared/electron/**/*.ts",
    "./../../appcore/modules/shared/tools/app-package.ts",
    "./../../appcore/modules/**/*.spec.ts",
    "node_modules"
  ]
}
