{
  "name": "elevate-webapp-server",
  "description": "Backend service for the Elevate web app: intervals.icu sync, activity computation, Postgres storage, and auth.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "engineStrict": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cookie-signature": "^1.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lodash": "^4.17.21",
    "lz-string": "^1.5.0",
    "moment": "^2.30.1",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsyringe": "^4.8.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cookie-signature": "^1.1.2",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/pino-http": "^5.8.4",
    "pino-http-print": "^4.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.16.2",
    "typescript": "^4.9.5"
  }
}
